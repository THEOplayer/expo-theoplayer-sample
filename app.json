{
  "expo": {
    "name": "expo-theoplayer-sample",
    "slug": "expo-theoplayer-sample",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "myapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.anonymous.expotheoplayersample"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.anonymous.expotheoplayersample"
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "./plugins/withAndroidDesugaring",
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff"
        }
      ],
      [
        "react-native-theoplayer",
        {
          "ios": {
            "extensions": [
              "cast",
              "ima",
              "millicast",
              "sideloaded-texttracks",
              "theoads"
            ]
          },
          "android": {
            "extensions": [
              "cast",
              "dai",
              "ima",
              "millicast",
              "theoads"
            ]
          }
        }
      ],
      [
        "react-native-google-cast",
        {
          "androidPlayServicesCastFrameworkVersion": "22.1.0",
          "receiverAppId": "CC1AD845"
        }
      ],
      "expo-font",
      "expo-status-bar",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
